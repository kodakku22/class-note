{
  "name": "class-notes-app",
  "version": "0.1.0",
  "description": "Local-first AI research workspace for researchers and graduate students",
  "author": "ClassNotes contributors",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/kodakku22/class-note.git"
  },
  "bugs": {
    "url": "https://github.com/kodakku22/class-note/issues"
  },
  "homepage": "https://github.com/kodakku22/class-note#readme",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-vite.mjs",
    "assets:icon": "node scripts/generate-icon.mjs",
    "build": "npm run assets:icon && tsc -b && node scripts/build-vite.mjs && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "perf:vault": "node scripts/perf-vault.mjs",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "hash:release": "node scripts/hash-release.mjs",
    "test:coverage": "vitest run --coverage",
    "test:release-smoke": "node scripts/release-smoke.mjs",
    "test:release-artifacts": "node scripts/release-artifacts.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:ipc-surface": "node scripts/ipc-surface.mjs",
    "security:evidence": "npm run security:sbom && npm run security:ipc-surface",
    "license:check": "node scripts/check-licenses.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && npx playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "npm run build && npx playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:smoke": "node scripts/release-smoke.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --max-warnings 0",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@axe-core/react": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "axe-core": "^4.11.4",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5.4.5",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.5",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@xyflow/react": "^12.10.2",
    "chokidar": "^3.6.0",
    "d3-force": "^3.0.0",
    "defuddle": "^0.18.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "linkedom": "^0.18.12",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-pdf": "^10.4.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tiptap-markdown": "^0.9.0",
    "yaml": "^2.8.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  }
}
